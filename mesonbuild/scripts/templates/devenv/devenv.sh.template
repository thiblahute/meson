# Meson development environment script for Bash/Zsh

devenvexit() {{
{restore_vars}

    if [ -n "${{_OLD_MESON_PS1:-}}" ]; then
        PS1="$_OLD_MESON_PS1"
        unset _OLD_MESON_PS1
    fi

    if [ -n "${{MESON_DEVENV_ACTIVE:-}}" ]; then
        unset MESON_DEVENV_ACTIVE
    fi

    if [ -n "${{MESON_DEVENV_BUILDDIR:-}}" ]; then
        unset MESON_DEVENV_BUILDDIR
    fi

    if [ "$1" != "nondestructive" ]; then
        unset -f devenvexit
    fi
}}

# Check if already in a Meson devenv
if [ -n "${{MESON_DEVENV_ACTIVE:-}}" ]; then
    echo "ERROR: Already in Meson devenv '$MESON_DEVENV_ACTIVE'. Please run 'devenvexit' first." >&2
    return 1
fi

{export_vars}

export MESON_DEVENV_ACTIVE="{project_name}"
export MESON_DEVENV_BUILDDIR="{builddir}"

if [ -z "${{MESON_DEVENV_DISABLE_PROMPT:-}}" ]; then
    _OLD_MESON_PS1="$PS1"
    PS1="[{project_name}] $PS1"
    export PS1
fi
